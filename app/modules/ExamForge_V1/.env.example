# MockExam_V1 환경 변수
# AI 커넥터 설정
ANTHROPIC_API_KEY=sk-ant-xxx
ACTIVE_TEXT_MODEL=opus46
ACTIVE_PLANNER_MODEL=opus46
ACTIVE_VERIFIER_MODEL=claude_sonnet
EXAMFORGE_ANSWER_KEY_SECRET=replace-with-32-plus-char-random-secret

# 파이프라인 설정
MAX_RETRIES=3
GENERATION_CONCURRENCY=4
VERIFICATION_CONCURRENCY=2

# 서버 설정
MOCK_EXAM_PORT=8900

# Gemini CLI 테스트 전용 패스스루
# 운영 커넥터가 아니라 로컬 live 보고서 생성시에만 true로 설정한다.
EXAMFORGE_GEMINI_CLI_TEST_ENABLED=false
EXAMFORGE_GEMINI_CLI_MODEL=gemini-2.5-flash
EXAMFORGE_GEMINI_CLI_TIMEOUT_SEC=240
EXAMFORGE_GEMINI_CLI_REPORT_DIR=app/modules/ExamForge_V1/artifacts/gemini_cli_reports
