# =============================================================================
# backend-fastapi 환경변수 예시 파일
# 실제 .env 파일을 만들 때 이 파일을 복사해서 사용한다.
# 시크릿 값(API 키, 비밀번호 등)은 절대 이 파일에 넣지 않는다.
# =============================================================================


# ========================
# 🔧 서버 기본 설정
# ========================

# [필수] 실행 환경 (string: local | staging | production)
APP_ENV=local

# [필수] 배포 환경 (string: development | staging | production)
# production 설정 시: Swagger UI 비활성화, CORS 제한 모드 적용
# 기본값: development
ENVIRONMENT=development

# [필수] 서버 포트 (int)
APP_PORT=8082

# [선택] 로그 레벨 (string: debug | info | warning | error | critical)
# 기본값: info
LOG_LEVEL=info

# [필수] PostgreSQL 연결 문자열 — asyncpg 직접 드라이버 사용 (SQLAlchemy 아님)
# 형식: postgresql://<user>:<password>@<host>:<port>/<dbname>
# ⚠️ postgresql+asyncpg:// 형식 금지 — asyncpg.create_pool()은 순수 postgresql:// 만 수용함
#
# Docker 환경 (sw-ez-shared 네트워크): 서비스명 "postgres"가 호스트가 됨
DATABASE_URL=postgresql://sw_ez:changeme@postgres:5432/sw_ez
#
# 로컬 개발 환경 (Docker 없이 호스트에서 직접 실행 시):
# DATABASE_URL=postgresql://sw_ez:changeme@localhost:5432/sw_ez

# [필수] ChapterStudio/FastAPI가 사용할 PostgreSQL schema
DATABASE_SCHEMA=chapter_studio

# [필수] Redis 연결 URL — Celery broker/backend 및 Agent 잡 스토어 공용
# 형식: redis://:<password>@<host>:<port>/<db-index>
# 비밀번호는 infra/.env 의 REDIS_PASSWORD 와 반드시 일치해야 함
#
# Docker 환경 (sw-ez-shared 네트워크): 서비스명 "redis"가 호스트가 됨
REDIS_URL=redis://:changeme@redis:6379/0
#
# 로컬 개발 환경:
# REDIS_URL=redis://:changeme@localhost:6379/0

# [선택] Qdrant 벡터 DB URL (RAG 검색 사용 시)
# Docker 환경 (sw-ez-shared 네트워크): 서비스명 "qdrant"가 호스트가 됨
QDRANT_URL=http://qdrant:6333
#
# 로컬 개발 환경:
# QDRANT_URL=http://localhost:6333

# [선택] OCR_v1 모듈 전용 Qdrant URL (OCR_V1_QDRANT_URL 환경변수 우선, 미설정 시 QDRANT_URL 또는 localhost:6333 기본값)
# Docker 환경에서는 QDRANT_URL 과 동일 값으로 맞춘다
OCR_V1_QDRANT_URL=http://qdrant:6333

# [선택] Qdrant API 키 (인증 없이 로컬 실행 시 생략 가능)
QDRANT_API_KEY=


# ========================
# 🤖 AI 모델 선택 (레지스트리)
# ========================
# 각 변수는 커넥터 레지스트리 키를 값으로 받는다.
# 로컬 Mac 기본값은 MLX 계열, Modal 배포 시 modal 계열 키로 변경한다.

# [선택] 범용 텍스트 생성 커넥터 키 (string: claude_sonnet | codex_cli | mlx_qwen3_local)
# 기본값: claude_sonnet
AI_MODEL=claude_sonnet

# [선택] ACTIVE_TEXT_MODEL — AI_MODEL 과 동일 역할, 신규 API 경로 호환용 별칭
# 기본값: claude_sonnet
ACTIVE_TEXT_MODEL=claude_sonnet

# [선택 — 로컬 개발 전용] 로컬 MLX Qwen3.6-35B-A3B 텍스트 생성 커넥터 경로
# 프로덕션에서는 claude_sonnet 또는 qwen27b_modal 사용
# 미설정 시 HF 캐시(~/.cache/huggingface/hub/)에서 자동 탐색한다
# MLX_QWEN3_MODEL_PATH=
# 로컬 MLX 커넥터 활성화 예시 (개발 환경):
# ACTIVE_TEXT_MODEL=mlx_qwen3_local

# [선택] TTS 커넥터 키 (string: mlx-audio-qwen3-tts | qwen3-tts-modal)
# 기본값: mlx-audio-qwen3-tts (로컬 Mac MLX)
AI_MODEL_TTS=mlx-audio-qwen3-tts

# [선택] ASR 커넥터 키 (string: mlx-qwen3-asr | mlx-whisper-turbo | sensevoice-small | asr-fallback | qwen3-asr-modal)
# 기본값: mlx-qwen3-asr (로컬 Mac MLX)
AI_MODEL_ASR=mlx-qwen3-asr

# [선택] OCR 커넥터 키 (string: paddleocr-vl-mlx | nemotron-ocr-v2 | paddleocr-ppv4)
# 기본값: paddleocr-vl-mlx (로컬 Mac MLX)
AI_MODEL_OCR=paddleocr-vl-mlx

# [선택] AI_MODEL_OCR 단축 별칭 (string: paddleocr_vl | nemotron_v2 | paddleocr_ppv4 등)
# AI_MODEL_OCR 이 설정돼 있으면 AI_OCR 은 무시된다
AI_OCR=paddleocr_vl

# [선택] 노이즈 제거 커넥터 키 (string: mossformer2-se-48k | mossformer2-modal)
# 기본값: mossformer2-se-48k (로컬 Mac PyTorch MPS)
AI_MODEL_DENOISE=mossformer2-se-48k

# [선택] MossFormer2-SE 노이즈 제거 모델 가중치 경로 또는 HF repo id (string)
# 비어있으면 HF 캐시에서 자동 다운로드
MOSSFORMER2_SE_MODEL_PATH=

# [선택] MossFormer2-SR 음성 향상 모델 가중치 경로 또는 HF repo id (string)
# 비어있으면 HF 캐시에서 자동 다운로드
MOSSFORMER2_SR_MODEL_PATH=

# [선택] OCR 후처리 LLM 커넥터 키 (string: kanana2-mlx | kanana2-modal)
# 기본값: kanana2-mlx (로컬 Mac MLX 4bit)
AI_MODEL_POSTPROC=kanana2-mlx

# [선택] 음성 네이티브 커넥터 키 (string: gemini-flash-live)
# 기본값: gemini-flash-live
AI_MODEL_VOICE=gemini-flash-live


# ========================
# 🔑 외부 API 키
# ========================

# [필수 — Claude 사용 시] Anthropic API 키 — 실제 값은 .env에만 입력
ANTHROPIC_API_KEY=

# [선택] Claude Sonnet 전용 API 키 — 설정 시 ANTHROPIC_API_KEY 보다 우선 적용
CLAUDE_SONNET_API_KEY=

# [선택] Gemini / Google Generative AI API 키 (Gemini Flash Live 사용 시 필수)
GEMINI_API_KEY=

# [선택] Google API 키 — GEMINI_API_KEY 와 동일 목적, 통합 자격증명 사용 시
GOOGLE_API_KEY=


# ========================
# 🧠 Claude Sonnet 설정
# ========================

# [선택] 사용할 Claude Sonnet 모델 ID (string)
# 기본값: claude-sonnet-4-5-20250929
CLAUDE_SONNET_MODEL=claude-sonnet-4-5-20250929

# [선택] Claude API 동시 요청 최대 수 (int: 1~8)
# 기본값: 4
CLAUDE_SONNET_MAX_CONCURRENCY=4

# [선택] Claude API 단일 요청 타임아웃 초 (int: 30~1200)
# 기본값: 300
CLAUDE_SONNET_TIMEOUT_SEC=300


# ========================
# 🎙️ Gemini Flash Live 설정
# ========================

# [선택] Gemini Flash Live 모델 ID (string)
# 기본값: gemini-2.0-flash-live-001
GEMINI_FLASH_LIVE_MODEL=gemini-2.0-flash-live-001

# [선택] Gemini Flash Live 세션 타임아웃 초 (float: 10~300)
# 기본값: 60
GEMINI_FLASH_LIVE_TIMEOUT_SEC=60

# [선택] Gemini CLI 서브프로세스 타임아웃 초 (float)
# 기본값: 240
GEMINI_CLI_TIMEOUT_SEC=240

# [선택] 테스트에서 실제 Gemini CLI 호출 활성화 (bool: 1 | 0)
# 기본값: 0 — 단위 테스트 환경에서는 생략하거나 0 유지
RUN_LIVE_GEMINI_CLI=0


# ========================
# 🔬 Codex CLI 설정
# ========================

# [선택] Codex CLI 에서 사용할 OpenAI 모델 ID (string)
# 기본값: gpt-5.4
CODEX_CLI_MODEL=gpt-5.4

# [선택] Codex CLI 추론 강도 (string: low | medium | high)
# 기본값: low
CODEX_CLI_REASONING_EFFORT=low

# [선택] Codex CLI 서브프로세스 타임아웃 초 (int: 30~600)
# 기본값: 180
CODEX_CLI_TIMEOUT_SEC=180


# ========================
# ☁️ Modal GPU 배포
# ========================

# [필수 — Modal 배포 시] Modal 계정 토큰 ID — 실제 값은 .env에만 입력
MODAL_TOKEN_ID=

# [필수 — Modal 배포 시] Modal 계정 토큰 시크릿 — 실제 값은 .env에만 입력
MODAL_TOKEN_SECRET=

# [선택] Modal 프로필 이름 (string) — 미설정 시 ~/.modal.toml 의 active 프로필 사용
MODAL_PROFILE=


# ========================
# 📖 ChapterStudio Modal
# ========================
# Qwen3.6-27B 등 대형 LLM 을 Modal GPU 서버리스로 실행하는 앱 설정이다.
# Modal 배포 시에만 유효하며, 로컬 개발 중에는 기본값을 그대로 두어도 된다.

# [선택] Modal 앱 이름 (string)
# 기본값: chapterstudio-qwen27b
CHAPTERSTUDIO_MODAL_APP_NAME=chapterstudio-qwen27b

# [선택] 배포할 HuggingFace 모델 ID (string)
# 기본값: Qwen/Qwen3.6-27B-FP8
CHAPTERSTUDIO_MODAL_MODEL_ID=Qwen/Qwen3.6-27B-FP8

# [선택] vLLM --served-model-name 에 전달할 별칭 (string)
# 기본값: CHAPTERSTUDIO_MODAL_APP_NAME 과 동일
CHAPTERSTUDIO_MODAL_MODEL_ALIAS=chapterstudio-qwen27b

# [선택] vLLM 최대 컨텍스트 토큰 수 (int)
# 기본값: 131072
CHAPTERSTUDIO_MODAL_MAX_MODEL_LEN=131072

# [선택] vLLM 배치당 최대 토큰 수 (int)
# 기본값: 32768
CHAPTERSTUDIO_MODAL_MAX_NUM_BATCHED_TOKENS=32768

# [선택] 언어 모델 전용 모드 활성화 — 멀티모달 비활성화 (bool: 1 | 0)
# 기본값: 0 (멀티모달 활성)
CHAPTERSTUDIO_MODAL_LANGUAGE_MODEL_ONLY=0

# [선택] ChapterStudio Planner 커넥터 키 (string: opus46 | claude_sonnet | codex_cli)
# 기본값: opus46
ACTIVE_PLANNER_MODEL=opus46

# [선택] ChapterStudio TTS 커넥터 키 (string: tts_v1 | tts_v2)
# 기본값: tts_v1
ACTIVE_TTS_MODEL=tts_v1

# [선택] ChapterStudio Modal 텍스트 앱 이름 — Qwen connector에서 사용
# 기본값: chapterstudio-qwen27b
QWEN_APP_NAME=chapterstudio-qwen27b

# [선택] ChapterStudio TTS HTTP 엔드포인트 — tts_v1 사용 시 설정
TTS_ENDPOINT=


# ========================
# 🎤 ASR (음성인식) 설정
# ========================

# [선택] SenseVoice-Small MLX 가중치 경로 또는 HuggingFace repo id (string)
# 비어있으면 mlx-community/SenseVoiceSmall 을 HF 캐시에서 자동 다운로드
SENSEVOICE_MODEL_PATH=

# [선택] Whisper Large V3 Turbo MLX 가중치 경로 또는 HF repo id (string)
# 비어있으면 mlx-community/whisper-large-v3-turbo 를 HF 캐시에서 자동 다운로드
WHISPER_TURBO_MODEL_PATH=

# [선택] Qwen3-ASR MLX 가중치 경로 또는 HF repo id (string)
# 비어있으면 Qwen/Qwen3-ASR-1.7B 를 HF 캐시에서 자동 다운로드
QWEN3_ASR_MODEL_PATH=

# [선택] Qwen3-TTS MLX 가중치 경로 또는 HF repo id (string)
# 비어있으면 HF 캐시에서 자동 다운로드
QWEN3_TTS_MODEL_PATH=

# [선택] ASR 폴백 tier 순서 — 쉼표 구분 커넥터 키 목록 (string)
# 기본값: mlx-whisper-turbo,sensevoice-small,mlx-qwen3-asr
ASR_FALLBACK_TIERS=mlx-whisper-turbo,sensevoice-small,mlx-qwen3-asr

# [선택] 폴백 품질 통과 최소 점수 임계값 (float: 0.0~1.0)
# 기본값: 0.6
ASR_FALLBACK_QUALITY_PASS=0.6

# [선택] 한국어 전사 최소 글자/초 임계값 (float)
# 기본값: 1.5
ASR_FALLBACK_MIN_CHARS_PER_SEC=1.5

# [선택] 할루시네이션 판정 n-gram 반복 최대 허용 횟수 (int)
# 기본값: 3
ASR_FALLBACK_MAX_REPEAT_NGRAM=3


# ========================
# 📸 OCR 설정
# ========================

# [선택] PaddleOCR-VL MLX 가중치 경로 또는 HF repo id (string)
# 비어있으면 mlx-community/PaddleOCR-VL-1.5-4bit 를 HF 캐시에서 자동 다운로드
PADDLEOCR_VL_MLX_MODEL_PATH=

# [선택] Kanana MLX 후처리 LLM 가중치 경로 또는 HF repo id (string)
# 비어있으면 squeezebits/kanana-1.5-2.1b-instruct-2505-mlx 를 자동 사용
KANANA_MLX_MODEL_PATH=

# [선택] Nemotron-OCR-v2 Modal 엔드포인트 URL (string)
# nemotron-ocr-v2 커넥터 사용 시 필수 — modal deploy 후 출력되는 URL 입력
NEMOTRON_OCR_V2_MODAL_URL=

# [선택] Nemotron-OCR-v2 단일 요청 타임아웃 초 (float)
# 기본값: 60.0
NEMOTRON_OCR_TIMEOUT_SEC=60.0

# [선택] Nemotron-OCR-v2 요청 실패 시 재시도 횟수 (int)
# 기본값: 1
NEMOTRON_OCR_RETRIES=1

# [필수] PDF/이미지 업로드 최대 크기 바이트 (int)
# 기본값: 1610612736 (1.5 GiB = 1.5 * 2^30)
MAX_PDF_UPLOAD_SIZE_BYTES=1610612736


# ========================
# 📋 Celery / 큐
# ========================

# [필수] Celery 브로커 URL — Redis 사용 권장
# 형식: redis://:<password>@<host>:<port>/<db-index>
# 비밀번호는 infra/.env 의 REDIS_PASSWORD 와 반드시 일치해야 함
# Docker 환경: 서비스명 "redis" 사용 / 로컬 환경: localhost 사용
CELERY_BROKER_URL=redis://:changeme@redis:6379/1
# 로컬 개발 환경: CELERY_BROKER_URL=redis://:changeme@localhost:6379/1

# [필수] Celery 결과 백엔드 URL
# Docker 환경: 서비스명 "redis" 사용 / 로컬 환경: localhost 사용
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/2
# 로컬 개발 환경: CELERY_RESULT_BACKEND=redis://:changeme@localhost:6379/2


# ========================
# 🤝 Agent Orchestrator
# ========================

# [선택] 잡 스토어 백엔드 타입 (string: memory | redis)
# 기본값: memory — 단일 인스턴스 로컬 개발용
# 프로덕션 다중 워커 환경에서는 redis 로 설정할 것
AGENT_JOB_STORE=memory

# [선택] Agent 잡 스토어 전용 Redis URL (string)
# 미설정 시 REDIS_URL 을 그대로 사용
AGENT_JOB_REDIS_URL=redis://:changeme@redis:6379/3

# [선택] AGENT_JOB_STORE=redis 인데 Redis URL 이 없을 때 예외 발생 여부 (bool: 1 | 0)
# 기본값: 0 — 미설정 시 memory 로 자동 폴백
AGENT_JOB_STORE_STRICT=0

# [선택] 잡 실행 방식 (string: background | celery)
# 기본값: background (FastAPI BackgroundTasks 사용)
# 프로덕션에서는 celery 권장
AGENT_JOB_EXECUTOR=background

# [선택] Agent 콜백 최대 재시도 횟수 (int)
# 기본값: 3
AGENT_CALLBACK_MAX_ATTEMPTS=3

# [선택] Agent 콜백 단일 시도 타임아웃 초 (float)
# 기본값: 5.0
AGENT_CALLBACK_TIMEOUT_SEC=5

# [선택] AI 생성 단계 최대 동시 처리 수 (int, 최솟값 1 강제)
# 기본값: 4
GENERATION_CONCURRENCY=4

# [선택] AI 검증 단계 최대 동시 처리 수 (int, 최솟값 1 강제)
# 기본값: 2
VERIFICATION_CONCURRENCY=2


# ========================
# 📨 Telegram
# ========================

# [선택] 텔레그램 봇 토큰 — 봇 기능 사용 시 필수 (string)
TELEGRAM_BOT_TOKEN=

# [선택] 텔레그램 봇 사용자명 @ 포함 불필요 (string)
TELEGRAM_BOT_USERNAME=your_bot_username


# ========================
# 🔒 보안 / Rate Limit
# ========================

# [필수 — 프로덕션] API 키 인증 — 모든 엔드포인트에 적용 (health/docs 제외)
# 비어있으면 인증 비활성화 (개발 환경 전용)
# ⚠️ 프로덕션 배포 시 반드시 랜덤 생성값 설정할 것
FASTAPI_API_KEY=

# [필수 — ExamForge 운영 채점] 생성된 정답 키 위변조 방지 HMAC secret
EXAMFORGE_ANSWER_KEY_SECRET=

# [선택] 분당 최대 요청 수 (int, 기본값: 60)
RATE_LIMIT_RPM=60

# [선택] 버스트 허용 토큰 수 (int, 기본값: 10)
RATE_LIMIT_BURST=10

# [필수 — 프로덕션] 허용 Origin 목록 (쉼표 구분)
# 프로덕션: CORS_ORIGINS=https://your-frontend.com
# 개발 환경: CORS_ORIGINS=* (모든 Origin 허용)
CORS_ORIGINS=*


# ========================
# 🧪 ExamForge Gemini CLI 테스트 전용
# ========================

# [선택 — 로컬 테스트 전용] ExamForge에서 Gemini CLI 패스스루 실행 허용 여부
# 기본값: false — 운영 커넥터가 아니므로 live 보고서 생성시에만 true로 설정
EXAMFORGE_GEMINI_CLI_TEST_ENABLED=false

# [선택 — 로컬 테스트 전용] Gemini CLI 모델 ID
# 실제 API 키 값은 코드/문서에 넣지 않고 로컬 Gemini CLI 인증 상태를 그대로 사용
EXAMFORGE_GEMINI_CLI_MODEL=gemini-2.5-flash

# [선택 — 로컬 테스트 전용] Gemini CLI 단일 실행 타임아웃 초
EXAMFORGE_GEMINI_CLI_TIMEOUT_SEC=240

# [선택 — 로컬 테스트 전용] 원문 응답/캡처/HTML 보고서 저장 위치
EXAMFORGE_GEMINI_CLI_REPORT_DIR=app/modules/ExamForge_V1/artifacts/gemini_cli_reports
