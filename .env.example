# backend-fastapi 환경변수
# 시크릿(API 키·비밀번호)은 .env 에만 채운다.

# 서버 기본 설정
# 프로덕션 배포 기준 예시다. 로컬 개발은 실제 .env에서 development/local로 덮어쓴다.
APP_ENV=production
ENVIRONMENT=production
APP_PORT=8082
LOG_LEVEL=info
# 배포자가 실제 PostgreSQL DSN을 주입한다. 예시 값이나 changeme 비밀번호를 운영에 쓰지 않는다.
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_SCHEMA=chapter_studio
REDIS_URL=redis://:<redis_password>@<redis_host>:6379/0
QDRANT_URL=https://<qdrant-host>:6333
OCR_V1_QDRANT_URL=https://<qdrant-host>:6333
QDRANT_API_KEY=

# S3 객체 저장소 — 기본 false면 기존 로컬 media/ 저장을 유지한다.
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=sw-ez-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=

# DB startup retry — DB 컨테이너가 늦게 떠도 FastAPI 부팅을 막지 않는다.
DB_POOL_INIT_RETRIES=5
DB_POOL_INIT_BACKOFF_SEC=1
DB_POOL_INIT_MAX_BACKOFF_SEC=5

# AI 모델 선택
# 프로덕션 기본은 Gemini 계열이다. MLX 계열은 M4/Mac 로컬 개발 전용으로 실제 .env에서만 쓴다.
AI_MODEL=gemini_flash
ACTIVE_TEXT_MODEL=gemini_flash
AI_MODEL_TTS=gemini-tts
AI_MODEL_ASR=gemini-asr
AI_MODEL_OCR=gemini-ocr
AI_OCR=gemini_ocr
AI_MODEL_DENOISE=mossformer2-se-48k
MOSSFORMER2_SE_MODEL_PATH=
MOSSFORMER2_SR_MODEL_PATH=
AI_MODEL_POSTPROC=kanana2-mlx
AI_MODEL_VOICE=gemini-flash-live

# 외부 API 키 (값은 .env 에만)
# Gemini 계열 LLM/TTS/ASR/OCR은 GOOGLE_API_KEY 또는 GEMINI_API_KEY 중 하나로 통합 운영 가능하다.
# Claude를 별도 사용하면 ANTHROPIC_API_KEY 또는 CLAUDE_SONNET_API_KEY를 추가 주입한다.
ANTHROPIC_API_KEY=
CLAUDE_SONNET_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Claude Sonnet 설정
CLAUDE_SONNET_MODEL=claude-sonnet-4-5-20250929
CLAUDE_SONNET_MAX_CONCURRENCY=4
CLAUDE_SONNET_TIMEOUT_SEC=300

# Gemini google-genai 텍스트 설정 (기본: gemini-3.5-flash)
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Gemini Flash Live 설정
GEMINI_FLASH_LIVE_MODEL=gemini-2.0-flash-live-001
GEMINI_FLASH_LIVE_TIMEOUT_SEC=60
GEMINI_CLI_TIMEOUT_SEC=240
RUN_LIVE_GEMINI_CLI=0
# Gemini 멀티모달 커넥터 기본값
# GEMINI_TTS_MODEL 기본값: gemini-3.1-flash-tts-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE 기본값: Kore
GEMINI_TTS_VOICE=Kore
# GEMINI_ASR_MODEL 기본값: gemini-3.5-flash
GEMINI_ASR_MODEL=gemini-3.5-flash
# GEMINI_OCR_MODEL 기본값: gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash

# Codex CLI 설정
CODEX_CLI_MODEL=gpt-5.4
CODEX_CLI_REASONING_EFFORT=low
CODEX_CLI_TIMEOUT_SEC=180

# Modal GPU 배포 (값은 .env 에만)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROFILE=
CHAPTERSTUDIO_MODAL_APP_NAME=chapterstudio-qwen27b
CHAPTERSTUDIO_MODAL_MODEL_ID=Qwen/Qwen3.6-27B-FP8
CHAPTERSTUDIO_MODAL_MODEL_ALIAS=chapterstudio-qwen27b
CHAPTERSTUDIO_MODAL_MAX_MODEL_LEN=131072
CHAPTERSTUDIO_MODAL_MAX_NUM_BATCHED_TOKENS=32768
CHAPTERSTUDIO_MODAL_LANGUAGE_MODEL_ONLY=0
ACTIVE_PLANNER_MODEL=opus46
ACTIVE_TTS_MODEL=tts_v1
# 내용 정확성 검증 전용 커넥터(미설정 시 ACTIVE_TEXT_MODEL을 그대로 사용)
ACTIVE_VERIFIER_MODEL=
# 강의 생성 후 분량·형식 self-check + targeted-repair 활성화 (기본 ON, 끄려면 false)
CHAPTERSTUDIO_LESSON_SELF_REPAIR=true
# 강의 내용 정확성(사실·논리) 검증 패스 ON/OFF (기본 ON, 끄려면 false)
CHAPTERSTUDIO_CONTENT_VERIFY=true
# 슬라이드 간 음성대본 도입부 응집성 재작성 ON/OFF (기본 ON, 끄려면 false)
VOICE_COHESION_ENABLED=true
# 퀴즈 보기 셔플로 정답 위치 균등화 ON/OFF (기본 ON, 끄려면 false)
QUIZ_BALANCE_ENABLED=true
QWEN_APP_NAME=chapterstudio-qwen27b
KANANA_MODAL_APP_NAME=kanana2-typofix
KANANA_MODAL_MODEL_ID=NotoriousH2/kanana-2-30b-a3b-instruct-2601-awq-w4a16
KANANA_POLISH_ENABLED=0
KANANA_POLISH_MAX_CONCURRENCY=8
TTS_ENDPOINT=

# 강의 생성 시 슬라이드별 튜터 음성 자동생성 (1=켬, Modal TTS 호출 발생). 기본 0
TTS_AUTOGEN_ENABLED=0
# 세그먼트 사이 무음 길이(ms). 60 권장(끊김 완화), 0~500. 기본 60
TTS_SEGMENT_PAUSE_MS=60
# 첫·끝 문장 끝에 물결표(~) 선택 적용해 말투를 부드럽게. 기본 true
TTS_SELECTIVE_TILDE=true
# TTS Modal 호출 타임아웃(초). 콜드스타트(풀 로드 ~360s) 흡수 위해 기본 900.
QWEN3_TTS_TIMEOUT_SEC=900
# 긴 음성대본 세그먼트 병렬 합성 동시성(1~POOL_SIZE). 기본 4
QWEN3_TTS_SEGMENT_CONCURRENCY=4
# 대량 음성 backfill 전 워밍업 1회로 콜드 타임아웃 방지. 기본 true
TTS_WARMUP_ENABLED=true

# 로컬 MLX 모델 경로 (미설정 시 HF 캐시 자동 탐색)
SENSEVOICE_MODEL_PATH=
WHISPER_TURBO_MODEL_PATH=
QWEN3_ASR_MODEL_PATH=
QWEN3_TTS_MODEL_PATH=
PADDLEOCR_VL_MLX_MODEL_PATH=
KANANA_MLX_MODEL_PATH=

# ASR 폴백
ASR_FALLBACK_TIERS=mlx-whisper-turbo,sensevoice-small,mlx-qwen3-asr
ASR_FALLBACK_QUALITY_PASS=0.6
ASR_FALLBACK_MIN_CHARS_PER_SEC=1.5
ASR_FALLBACK_MAX_REPEAT_NGRAM=3

# OCR
NEMOTRON_OCR_V2_MODAL_URL=
NEMOTRON_OCR_TIMEOUT_SEC=60.0
NEMOTRON_OCR_RETRIES=1
MAX_PDF_UPLOAD_SIZE_BYTES=1610612736

# Celery
CELERY_BROKER_URL=redis://:changeme@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/2

# Agent Orchestrator
AGENT_JOB_STORE=memory
AGENT_JOB_REDIS_URL=redis://:changeme@redis:6379/3
AGENT_JOB_STORE_STRICT=0
AGENT_JOB_EXECUTOR=background
AGENT_CALLBACK_MAX_ATTEMPTS=3
AGENT_CALLBACK_TIMEOUT_SEC=5
GENERATION_CONCURRENCY=4
VERIFICATION_CONCURRENCY=2

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username

# 보안 / Rate Limit
FASTAPI_API_KEY=
# 정답 키 위변조 방지 HMAC secret — 배포자가 32자 이상 무작위 문자열을 반드시 주입한다.
EXAMFORGE_ANSWER_KEY_SECRET=
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
# 프로덕션은 실제 프론트 도메인을 쉼표로 지정한다. 와일드카드(*)를 운영에 쓰지 않는다.
CORS_ORIGINS=https://your-frontend.example.com

# ExamForge 품질 견고성 스위치
# 정답 검증을 관측 전용으로 두고 재시도/교정 게이트에는 쓰지 않음 (codex_cli 임시 사용 시 true 권장)
EXAMFORGE_VERIFICATION_ADVISORY=false
# 검증 실패 문항의 표적 교정 경로 활성화 (기본 ON, 회귀 의심 시 false로 끄면 blind 재생성 폴백)
EXAMFORGE_TARGETED_REPAIR=true
# 오답 선택지 재작성 노드 활성화 (기본 ON, 코드 헤비 보기 환경에서 false로 끄면 초기 보기 보존)
EXAMFORGE_DISTRACTOR_REWRITE=true

# ExamForge Gemini CLI 테스트 전용
EXAMFORGE_GEMINI_CLI_TEST_ENABLED=false
EXAMFORGE_GEMINI_CLI_MODEL=gemini-2.5-flash
EXAMFORGE_GEMINI_CLI_TIMEOUT_SEC=240
EXAMFORGE_GEMINI_CLI_REPORT_DIR=app/modules/ExamForge_V1/artifacts/gemini_cli_reports
