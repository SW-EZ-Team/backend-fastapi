# FastAPI 애플리케이션 환경변수 (로컬 dev)
# infra 레포의 sw-ez-shared 네트워크에 조인하면 서비스명으로 접속한다

# 서버
APP_ENV=local
APP_PORT=8082
LOG_LEVEL=info

# Postgres (SQLAlchemy 2.0 async 드라이버 asyncpg)
DATABASE_URL=postgresql+asyncpg://sw_ez:changeme@postgres:5432/sw_ez

# Redis (Celery broker + backend)
REDIS_URL=redis://:changeme@redis:6379/0
CELERY_BROKER_URL=redis://:changeme@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/2

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# 텔레그램 봇 (https://t.me/ilgwa_EZ_Team_bot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=ilgwa_EZ_Team_bot
